
const express = require('express');
const db =require('./db');

const app = express();
app.use(express.json());
app.get('/students',(req,res)=>{
    db.query("SELECT * FROM students",(error,results)=>{
        if(error){
            res.status(404).send(error.message);
        }
        res.status(200).json(results);
    })
})

app.get('/students/:id',(req,res)=>{
    db.query(`SELECT * FROM students WHERE id = ?`,[req.params.id],(error,results)=>{
        if(error){
            res.status(404).json({
                message:"database error"
            })
        }

       if(results.length === 0){
        res.status(404).json({
            message:"student not found"
        })
       }
        res.status(200).json(results)
    })
})

app.post('/students',(req,res)=>{
    const {name,id,email,age} =req.body;
    db.query(`INSERT INTO students (id,name,email,age) VALUES (?,?,?,?)`,[id,name,email,age],(error,results)=>{
        if(error){
            res.status(404).json({
                message:"database error"
            })
        }
        res.status(200).json({
            message:"students added successfully",
            insertedId:results.insertId
        })
    })
})

app.put('/students/:id', (req, res) => {

    const id = req.params.id;

    const { name, email, age } = req.body;

    db.query(
        "UPDATE students SET name = ?, email = ?, age = ? WHERE id = ?",
        [name, email, age, id],
        (error, results) => {

            if (error) {
                return res.status(500).json({
                    message: "database error"
                });
            }

            if (results.affectedRows === 0) {
                return res.status(404).json({
                    message: "student not found"
                });
            }

            // UPDATE is finished.
            // Now get the updated student.

            db.query(
                "SELECT * FROM students WHERE id = ?",
                [id],
                (error, results) => {

                    if (error) {
                        return res.status(500).json({
                            message: "database error"
                        });
                    }

                    res.status(200).json({
                        message: "Students Updated Successfully",
                        updatedId: id,
                        data: results[0]
                    });

                }
            );

        }
    );
});


app.delete('/students/:id',(req,res)=>{
    const id =req.params.id;
    db.query('DELETE FROM students WHERE id = ?',[id],(error,results)=>{
        if(error){
            res.status(404).json({
                message:"database error"
            })
        }
        if(results.affectedRows ===0){
            res.status(404).json({
                message :"student is not deleted"
            })
        }

        
    
    
        db.query('SELECT *FROM students ',(error,results)=>{
            if(error){
                res.status(404).json({
                    message:"database error"
                })
            }
            res.status(200).json({
                message:"students deleted successfully",
                data:results
            })

        }
    );
    
    }
);
});

app.listen(3000,()=>{
    console.log("the server is running on port 3000");
})
